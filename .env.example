# Supabase Project Settings > API (server-only values; never prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
# Supabase Connect > Transaction pooler URI (port 6543); encode special password characters
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres
# Exact verified email of your owner account, created in Supabase Authentication > Users
ADMIN_EMAIL=owner@example.com
SUPABASE_STORAGE_BUCKET=stillwater-private
